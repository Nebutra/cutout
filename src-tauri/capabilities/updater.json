{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-updater",
  "description": "Grants Cutout's policy-checked updater commands and only the notification commands needed for opt-in release alerts; raw updater and process commands remain unavailable to JavaScript.",
  "windows": ["main"],
  "platforms": ["macOS", "windows", "linux"],
  "permissions": [
    "updater-runtime",
    "workspace-revision-bridge",
    "project-files",
    "packaged-e2e",
    "provider-secrets-network",
    "codex-system-runtime",
    "git-version-control",
    "registry-and-agent-host",
    "speech-host",
    "foreground-segmentation",
    "monotonic-deadline",
    "game-map-processing",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
